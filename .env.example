# TikTok handle, with or without the leading @.
TIKTOK_USERNAME=your_streamer_handle
# Generate a long random value. Configure the same value as a Roblox Secret
# named TIKTOK_RELAY_SECRET in Creator Hub; do not put it in a LocalScript.
RELAY_SECRET=replace-with-at-least-32-random-characters
PORT=8787
MOCK_MODE=false
MAX_QUEUE=2000
MAX_REQUESTS_PER_MINUTE=240
